{
  "_comment": "Shield360 prompt-injection rules. The one definition both detectors load: cli/internal/coding/injection (Go, embedded) and src/client/src/lib/security/injection (TypeScript, a byte-identical copy kept in step by `npm run injection:sync-rules` and checked by tests on both sides). Patterns are written in the subset Go RE2 and JavaScript (u flag) read the same way: no lookaround, no backreferences, no \\u escapes, and matching is always case-insensitive. Bump version whenever a rule changes. A rule may list `any`: literal substrings, one of which must appear (after folding ASCII case, and ſ/K to s/k) for its patterns to be tried at all. It is only a speed-up, so every alternative of every pattern must contain one of them.",
  "version": "2026.10.29-2",
  "threshold": 0.5,
  "maxScanChars": 200000,
  "snippetChars": 48,
  "maxSpans": 5,
  "rules": [
    {
      "id": "override.ignore_previous",
      "category": "override",
      "description": "Tells the model to ignore, forget or override the instructions it was given.",
      "weight": 0.8,
      "decoded": true,
      "any": [
        "ignor",
        "disregard",
        "forget",
        "overrid",
        "bypass",
        "neglect",
        "follow"
      ],
      "patterns": [
        "\\b(?:ignore|disregard|forget|override|bypass|neglect)\\s+(?:(?:all|any|every|each)\\s+(?:of\\s+)?(?:the\\s+|your\\s+|my\\s+|these\\s+|those\\s+)?|(?:your|my)\\s+)?(?:previous|prior|above|earlier|preceding|foregoing|original|initial|old|existing|system)\\s+(?:instructions?|prompts?|directions?|rules|guidelines|directives?|commands?|context|guidance|programming|constraints|restrictions)\\b",
        "\\b(?:ignore|disregard|forget|override)\\s+(?:all\\s+of\\s+|all\\s+)?the\\s+(?:above|foregoing|preceding|system)\\s+(?:instructions?|prompts?|directions?|rules|guidelines|directives?|commands?|context|text|message)\\b",
        "\\b(?:ignore|disregard|forget)\\s+(?:all\\s+of\\s+)?(?:the\\s+)?(?:above|everything\\s+(?:above|before|else))\\s+and\\s+(?:instead|now|just|only|say|print|output|respond|reply|write|translate|tell)\\b",
        "\\b(?:ignore|disregard|forget)\\s+(?:all\\s+|any\\s+)?(?:your|the)\\s+(?:safety|content|ethical)\\s+(?:guidelines|rules|policies|filters|restrictions|training)\\b",
        "\\b(?:ignore|disregard|forget|stop\\s+following|no\\s+longer\\s+follow|quit\\s+following)\\s+(?:all\\s+|any\\s+|every\\s+)?(?:of\\s+)?(?:the\\s+|your\\s+)?(?:rules|instructions|guidelines|directives)\\s+(?:you\\s+(?:were|have\\s+been)\\s+given|you\\s+received|given\\s+to\\s+you|you\\s+were\\s+told)\\b",
        "\\b(?:ignore|disregard|forget)\\s+(?:all\\s+(?:of\\s+)?)?your\\s+(?:instructions|directives|programming)(?:\\s+(?:you\\s+(?:have\\s+|'ve\\s+)?(?:received|been\\s+given|got(?:ten)?)|so\\s+far|until\\s+now|up\\s+to\\s+now)\\b|\\s+and\\s|\\s*[.!;:]|\\s*$)",
        "\\b(?:ignore|disregard|forget)\\s+all\\s+(?:of\\s+)?(?:the\\s+)?(?:instructions|directives)\\s+(?:you\\s+(?:have\\s+|'ve\\s+)?(?:received|been\\s+given|got(?:ten)?)|so\\s+far|until\\s+now|up\\s+to\\s+now|and\\s+(?:instead|now|just|only|say|print|output|respond|reply|write|tell|reveal|show))\\b",
        "\\b(?:forget|disregard|ignore)\\s+everything\\s+(?:you\\s+(?:were|have\\s+been|'ve\\s+been)\\s+(?:told|taught|instructed|given))\\b"
      ]
    },
    {
      "id": "override.multilingual",
      "category": "override",
      "description": "The same instruction override, in other languages.",
      "weight": 0.75,
      "decoded": true,
      "any": [
        "ignor",
        "vergiss",
        "vergesst",
        "vergessen",
        "oubli",
        "olvid",
        "dimentic",
        "esque",
        "игнор",
        "Игнор",
        "ИГНОР",
        "забуд",
        "Забуд",
        "ЗАБУД",
        "忽略"
      ],
      "patterns": [
        "\\bignor(?:a|e|ez|iere|ieren|ar)\\s+(?:todas\\s+|toutes\\s+|alle\\s+|tutte\\s+)?(?:las\\s+|les\\s+|die\\s+|le\\s+|deine\\s+|ihre\\s+|tes\\s+|vos\\s+|tus\\s+|sus\\s+)?(?:instrucciones|instructions|anweisungen|istruzioni|instru[cç][oõ]es)\\s+(?:anteriores|pr[ée]c[ée]dentes|vorherigen|precedenti|ci-dessus)",
        "\\bignor(?:a|e|ez|iere|ieren|ar)\\s+(?:todas\\s+|toutes\\s+|alle\\s+|tutte\\s+)?(?:las\\s+|les\\s+|die\\s+|le\\s+|deine\\s+|ihre\\s+)?(?:anteriores|pr[ée]c[ée]dentes|vorherigen|bisherigen|obigen|vorigen|precedenti)\\s+(?:instrucciones|instructions|anweisungen|istruzioni)",
        "\\b(?:vergiss|vergesst|vergessen\\s+sie|oublie[sz]?|olvida|olvide|olviden|dimentica|dimenticate|esque[cç]a)\\s+(?:todas\\s+|toutes\\s+|alle\\s+|tutte\\s+)?(?:las\\s+|les\\s+|die\\s+|le\\s+|as\\s+|deine\\s+|ihre\\s+|tes\\s+|vos\\s+|tus\\s+|sus\\s+)?(?:instrucciones|instructions|anweisungen|istruzioni|instru[cç][oõ]es)\\s+(?:anteriores|pr[ée]c[ée]dentes|vorherigen|bisherigen|precedenti|ci-dessus)",
        "\\b(?:vergiss|vergesst|vergessen\\s+sie)\\s+(?:alle\\s+)?(?:die\\s+|deine\\s+|ihre\\s+)?(?:vorherigen|bisherigen|obigen|vorangegangenen|vorigen)\\s+(?:anweisungen|instruktionen|befehle|regeln)",
        "(?:игнорируй|игнорируйте|забудь|забудьте)\\s+(?:все\\s+)?(?:предыдущие|прошлые|прежние)\\s+(?:инструкции|указания|команды)",
        "忽略(?:之前|以上|上面|先前|前面|所有)(?:的)?(?:所有)?(?:的)?(?:指令|指示|说明|规则|提示)"
      ]
    },
    {
      "id": "override.reveal_system_prompt",
      "category": "override",
      "description": "Asks the model to disclose its system prompt or hidden instructions.",
      "weight": 0.6,
      "decoded": true,
      "any": [
        "your",
        "above"
      ],
      "patterns": [
        "\\b(?:reveal|show|print|output|display|repeat|leak|dump|disclose|expose|recite|give\\s+me|tell\\s+me|share|write\\s+out)\\s+(?:me\\s+)?your\\s+(?:(?:entire|full|complete|exact|original|hidden|secret|initial|internal)\\s+)*(?:system\\s+prompt|system\\s+message|system\\s+instructions|initial\\s+(?:prompt|instructions)|hidden\\s+(?:prompt|instructions)|developer\\s+(?:prompt|message|instructions)|pre-?prompt|instructions\\s+verbatim)\\b",
        "\\brepeat\\s+(?:all\\s+of\\s+|everything\\s+in\\s+|the\\s+)?(?:words|text|content|instructions)\\s+above\\b[^\\n]{0,60}\\b(?:verbatim|starting\\s+with|beginning\\s+with|word\\s+for\\s+word)",
        "\\bwhat\\s+(?:are|were)\\s+your\\s+(?:system|initial|original|hidden)\\s+(?:instructions|prompt)\\b"
      ]
    },
    {
      "id": "override.new_instructions",
      "category": "override",
      "description": "Announces replacement instructions or a system-prompt update.",
      "weight": 0.4,
      "decoded": true,
      "any": [
        "instruction",
        "directive"
      ],
      "patterns": [
        "\\b(?:new|updated|revised|real|actual|true|secret|hidden)\\s+(?:system\\s+)?(?:instructions?|directives?)\\s*:"
      ]
    },
    {
      "id": "override.system_override",
      "category": "override",
      "description": "Claims to update the system prompt or to outrank earlier instructions.",
      "weight": 0.55,
      "decoded": true,
      "any": [
        "overrid",
        "update",
        "injection",
        "priority",
        "precedence",
        "supersede"
      ],
      "patterns": [
        "\\b(?:system|developer)\\s+(?:prompt|message|instructions?)\\s+(?:override|update|injection)\\b",
        "\\b(?:these|the\\s+following|this\\s+server'?s?)\\s+(?:instructions?|rules)\\s+(?:take|takes|have|has)\\s+(?:priority|precedence)\\s+over\\b",
        "\\b(?:rules|instructions)\\s+supersede\\s+(?:all\\s+)?(?:previous|prior|other|any)\\s+(?:instructions|rules|guidelines)\\b",
        "\\bsupersedes?\\s+(?:all\\s+)?(?:previous|prior|other|any)\\s+(?:instructions|rules|guidelines)\\b"
      ]
    },
    {
      "id": "override.persona_reset",
      "category": "override",
      "description": "Reassigns the model's identity or purpose from now on.",
      "weight": 0.45,
      "decoded": true,
      "any": [
        "now"
      ],
      "patterns": [
        "\\bfrom\\s+now\\s+on,?\\s+(?:you\\s+(?:are|will\\s+(?:act|be|pretend|play|roleplay)|must\\s+(?:act|pretend|be))|your\\s+new\\s+(?:name|role|identity|persona|purpose))\\b"
      ]
    },
    {
      "id": "override.new_task",
      "category": "override",
      "description": "Hands the model a new task or objective. Weak alone: people assign tasks too.",
      "weight": 0.35,
      "decoded": true,
      "any": [
        "your"
      ],
      "patterns": [
        "\\byour\\s+(?:new|only|sole|real)\\s+(?:task|job|objective|goal|purpose|mission)\\s+(?:now\\s+)?(?:is|will\\s+be)\\s+to\\b"
      ]
    },
    {
      "id": "indirect.ignore_user",
      "category": "indirect",
      "description": "Content that tells the model to disregard what its user asked.",
      "weight": 0.5,
      "decoded": true,
      "any": [
        "ignor",
        "disregard",
        "forget"
      ],
      "patterns": [
        "\\b(?:ignore|disregard|forget)\\s+(?:the\\s+)?(?:user|human|developer|sender|requester)'?s?\\s+(?:question|request|instructions?|query|input|message|prompt|task)s?\\b"
      ]
    },
    {
      "id": "indirect.persistence",
      "category": "indirect",
      "description": "Tells an agent to plant something that survives the session: shell profiles, cron, SSH keys.",
      "weight": 0.5,
      "weights": {
        "prompt": 0.2
      },
      "decoded": true,
      "any": [
        "bashrc",
        "zshrc",
        "profile",
        "crontab",
        "authorized_keys",
        "/etc/hosts"
      ],
      "patterns": [
        "\\b(?:add|append|write|insert|put)\\s+(?:the\\s+following|this|these)\\s+(?:lines?|commands?|entry|entries|key)\\s+(?:to|into|in)\\s+(?:your\\s+|the\\s+)?(?:~/\\.(?:bashrc|zshrc|profile|bash_profile)|\\.(?:bashrc|zshrc|profile|bash_profile)\\b|crontab|authorized_keys|~/\\.ssh/authorized_keys|/etc/hosts)"
      ]
    },
    {
      "id": "roleplay.dan",
      "category": "roleplay",
      "description": "Named jailbreak personas (DAN and its variants).",
      "weight": 0.8,
      "decoded": true,
      "any": [
        "dan",
        "stan",
        "dude",
        "anything",
        "jailbreak",
        "classic"
      ],
      "patterns": [
        "\\b(?:dan|stan|dude|anti-?dan|better-?dan)\\s+(?:mode|prompt|jailbreak)\\b",
        "\\bdo\\s+anything\\s+now\\b",
        "\\[(?:🔓\\s*jailbreak|🔒\\s*classic|jailbreak|classic)\\]"
      ],
      "weights": {
        "file": 0.3
      }
    },
    {
      "id": "roleplay.unrestricted_mode",
      "category": "roleplay",
      "description": "Switches the model into an unrestricted or jailbroken mode.",
      "weight": 0.7,
      "decoded": true,
      "any": [
        "mode"
      ],
      "patterns": [
        "\\b(?:god|jailbreak|jailbroken|unrestricted|unfiltered|uncensored|evil|chaos|anarchy|opposite)\\s+mode\\s+(?:enabled|activated|on|output|response)\\b",
        "\\b(?:enable|activate|enter|simulate|switch\\s+to|you\\s+are\\s+(?:now\\s+)?in)\\s+(?:the\\s+)?(?:god|jailbreak|jailbroken|unrestricted|unfiltered|uncensored|evil|chaos|anarchy)\\s+mode\\b",
        "\\b(?:simulate|act\\s+in|you\\s+are\\s+(?:now\\s+)?in)\\s+(?:the\\s+)?developer\\s+mode\\b",
        "\\bdeveloper\\s+mode\\s+output\\b"
      ]
    },
    {
      "id": "roleplay.unrestricted_persona",
      "category": "roleplay",
      "description": "Asks the model to become an unrestricted, amoral or evil character.",
      "weight": 0.7,
      "decoded": true,
      "any": [
        "unrestrict",
        "unfilter",
        "uncensor",
        "unalign",
        "unbound",
        "unchain",
        "amoral",
        "immoral",
        "unethical",
        "evil",
        "jailbr",
        "rogue",
        "lawless",
        "limitless"
      ],
      "patterns": [
        "\\b(?:you\\s+are\\s+(?:now\\s+)?|act\\s+as\\s+|pretend\\s+(?:to\\s+be|you\\s+are)\\s+|role-?play\\s+as\\s+|behave\\s+like\\s+|become\\s+)(?:an?\\s+)?(?:unrestricted|unfiltered|uncensored|unaligned|unbound|unchained|amoral|immoral|unethical|evil|jailbroken|rogue|lawless|limitless)\\b"
      ]
    },
    {
      "id": "roleplay.no_restrictions",
      "category": "roleplay",
      "description": "Claims the model is no longer bound by its policies or safety rules.",
      "weight": 0.6,
      "decoded": true,
      "any": [
        "bound",
        "restrict",
        "limit",
        "constrain",
        "ethic",
        "moral",
        "safety",
        "content",
        "free",
        "filter",
        "rules",
        "guideline"
      ],
      "patterns": [
        "\\b(?:not|no\\s+longer)\\s+(?:bound|restricted|limited|constrained)\\s+by\\s+(?:any\\s+)?(?:openai|anthropic|google|content|safety|ethical|moral|your)\\s+(?:polic(?:y|ies)|rules|guidelines|restrictions|filters|programming|principles)\\b",
        "\\b(?:without|with\\s+no|free\\s+(?:of|from))\\s+(?:any\\s+)?(?:ethical|moral|safety|content)\\s+(?:restrictions|filters|guidelines|limitations|constraints|policies|safeguards)\\b",
        "\\b(?:has|have)\\s+(?:been\\s+)?(?:freed|broken\\s+free)\\s+(?:from|of)\\s+(?:the\\s+)?(?:typical\\s+)?(?:confines|restrictions|limits)\\s+of\\s+(?:ai|openai)\\b",
        "\\b(?:ai|assistant|model|chatbot|bot)\\s+(?:that|which|who)\\s+(?:has|have)\\s+no\\s+(?:restrictions|filters|limits|rules|guidelines|morals|ethics)\\b"
      ]
    },
    {
      "id": "roleplay.token_game",
      "category": "roleplay",
      "description": "The token-penalty game jailbreaks use to keep a persona going.",
      "weight": 0.5,
      "decoded": true,
      "any": [
        "token"
      ],
      "patterns": [
        "\\byou\\s+(?:have|will\\s+lose|start\\s+with)\\s+\\d+\\s+tokens\\b",
        "\\btokens?\\s+will\\s+be\\s+deducted\\b"
      ]
    },
    {
      "id": "roleplay.fiction_bypass",
      "category": "roleplay",
      "description": "Fiction or hypothetical framing used to lift restrictions, and the grandma exploit.",
      "weight": 0.4,
      "decoded": true,
      "any": [
        "hypothetical",
        "fiction",
        "novel",
        "story",
        "movie",
        "screenplay",
        "grand",
        "character"
      ],
      "patterns": [
        "\\b(?:hypothetically|in\\s+a\\s+fictional\\s+world|for\\s+a\\s+(?:novel|story|movie|screenplay))\\b[^\\n]{0,80}\\b(?:no|without)\\s+(?:rules|restrictions|limits|filters|guidelines)\\b",
        "\\b(?:deceased|late|dead)\\s+grand(?:ma|mother|pa|father)\\s+(?:who\\s+)?used\\s+to\\s+(?:tell|read|recite|say|explain)\\b",
        "\\bstay\\s+in\\s+character\\b[^\\n]{0,80}\\b(?:no\\s+matter|whatever|always|never\\s+break)\\b"
      ]
    },
    {
      "id": "roleplay.grandma",
      "category": "roleplay",
      "description": "The grandma exploit: asking the model to play a relative who recited forbidden content.",
      "weight": 0.6,
      "decoded": true,
      "any": [
        "grand"
      ],
      "patterns": [
        "\\b(?:act|acting|pretend|role-?play|play)\\s+(?:as|to\\s+be)\\s+my\\s+(?:deceased|late|dead)\\s+grand(?:ma|mother|pa|father)\\b"
      ]
    },
    {
      "id": "roleplay.bypass_safety",
      "category": "roleplay",
      "description": "Asks how a model would get around its own safety controls.",
      "weight": 0.45,
      "decoded": true,
      "any": [
        "bypass"
      ],
      "patterns": [
        "\\bbypass\\s+(?:its|your|the\\s+model'?s|the\\s+ai'?s)\\s+(?:own\\s+)?(?:content\\s+filters?|safety\\s+(?:filters?|guidelines|training|rules)|guardrails|restrictions)\\b"
      ]
    },
    {
      "id": "roleplay.jailbreak_word",
      "category": "roleplay",
      "description": "The word jailbreak. Weak on its own: phones are jailbroken too.",
      "weight": 0.3,
      "decoded": true,
      "any": [
        "jailbr"
      ],
      "patterns": [
        "\\bjailbr(?:eak|oken|eaking)\\b"
      ],
      "weights": {
        "file": 0.1
      }
    },
    {
      "id": "jailbreak.refusal_suppression",
      "category": "jailbreak",
      "description": "Forbids the model from refusing, apologising or warning: the refusal-suppression half of most jailbreaks.",
      "weight": 0.4,
      "decoded": true,
      "any": [
        "refus",
        "apolog",
        "disclaim",
        "warning",
        "can't",
        "cannot",
        "unable",
        "declin",
        "caveat"
      ],
      "patterns": [
        "\\b(?:never|do\\s+not|don't|must\\s+not|you\\s+(?:can|will)\\s*not|you\\s+won't)\\s+(?:ever\\s+)?(?:refuse|decline|apologi[sz]e|say\\s+(?:that\\s+)?(?:you\\s+)?(?:can't|cannot|are\\s+unable))\\b",
        "\\b(?:without|with\\s+no|(?:never|do\\s+not|don't)\\s+(?:add|include|give))\\s+(?:any\\s+)?(?:warnings?|disclaimers?|caveats?|refusals?)\\s+(?:or|and|,)\\s*(?:any\\s+)?(?:warnings?|disclaimers?|caveats?|refusals?|moral(?:izing|ising)?|lectures?)\\b"
      ]
    },
    {
      "id": "jailbreak.prefix_injection",
      "category": "jailbreak",
      "description": "Dictates an affirmative opening (\"Sure, here is\") so the model talks itself past a refusal.",
      "weight": 0.5,
      "decoded": true,
      "any": [
        "start",
        "begin"
      ],
      "patterns": [
        "\\b(?:start|begin)\\s+(?:your|each|every)\\s+(?:response|reply|answer|output)s?\\s+with\\s+[\"'“]?(?:sure|absolutely|certainly|of\\s+course|yes)\\b[^\\n]{0,40}\\b(?:here\\s+is|here's|i\\s+can|i\\s+will)\\b"
      ]
    },
    {
      "id": "jailbreak.dual_response",
      "category": "jailbreak",
      "description": "Asks for two answers, a normal one and an unfiltered one.",
      "weight": 0.6,
      "decoded": true,
      "any": [
        "respon",
        "answer",
        "repl",
        "output"
      ],
      "patterns": [
        "\\b(?:two|2|both)\\s+(?:different\\s+|separate\\s+)?(?:responses|answers|replies|outputs)\\b[^\\n]{0,120}\\b(?:unfiltered|uncensored|jailbroken|unrestricted|without\\s+(?:any\\s+)?(?:filters?|restrictions|rules))\\b"
      ]
    },
    {
      "id": "jailbreak.named_persona",
      "category": "jailbreak",
      "description": "Named jailbreak characters beyond DAN (AIM, Mongo Tom, evil confidant, BetterDAN and similar).",
      "weight": 0.7,
      "decoded": true,
      "any": [
        "machiavel",
        "mongo",
        "confidant",
        "aim",
        "betterdan",
        "apophis",
        "maximum",
        "omega",
        "apophis"
      ],
      "patterns": [
        "\\balways\\s+intelligent\\s+and\\s+machiavellian\\b",
        "\\bmongo\\s+tom\\b",
        "\\bevil\\s+(?:trusted\\s+)?confidant\\b",
        "\\b(?:act|you\\s+are|play|become)\\s+(?:as\\s+)?(?:aim|apophis|betterdan|omega|maximum)\\b[^\\n]{0,80}\\b(?:unfiltered|amoral|no\\s+(?:ethical|moral)|without\\s+(?:any\\s+)?(?:restrictions|filters))\\b"
      ]
    },
    {
      "id": "jailbreak.payload_splitting",
      "category": "jailbreak",
      "description": "Splits a forbidden request into pieces and asks the model to join them and act on the result.",
      "weight": 0.55,
      "decoded": true,
      "any": [
        "concaten",
        "combin",
        "join",
        "string",
        "variable",
        "merge"
      ],
      "patterns": [
        "\\b(?:concatenate|combine|join|merge)\\s+(?:the\\s+)?(?:strings?|variables?|parts|pieces|words)\\b[^\\n]{0,80}\\b(?:then|and)\\s+(?:answer|respond\\s+to|follow|execute|carry\\s+out|do\\s+what)\\b"
      ]
    },
    {
      "id": "jailbreak.authority_claim",
      "category": "jailbreak",
      "description": "Claims to be the model's developer or vendor to unlock restricted behaviour.",
      "weight": 0.55,
      "decoded": true,
      "any": [
        "develop",
        "creator",
        "openai",
        "anthropic",
        "admin",
        "engineer"
      ],
      "patterns": [
        "\\b(?:i\\s+am|i'm)\\s+(?:your|an?|the)\\s+(?:developer|creator|openai|anthropic|admin(?:istrator)?|system\\s+engineer)\\b[^\\n]{0,80}\\b(?:override|unlock|disable|lift|remove|bypass|authori[sz](?:e|ed|ing))\\b[^\\n]{0,40}\\b(?:restrictions|filters|safety|rules|guardrails|guidelines)\\b"
      ]
    },
    {
      "id": "delimiter.chat_template",
      "category": "delimiter",
      "description": "Chat-template control tokens that fake a new system or assistant turn.",
      "weight": 0.6,
      "weights": {
        "file": 0.15
      },
      "decoded": true,
      "any": [
        "<|",
        "inst]",
        "<<sys>>",
        "<</sys>>"
      ],
      "patterns": [
        "<\\|(?:im_start|im_end|system|user|assistant|endoftext|start_header_id|end_header_id|eot_id|begin_of_text)\\|>",
        "\\[/?INST\\]",
        "<</?SYS>>"
      ]
    },
    {
      "id": "delimiter.fake_system_block",
      "category": "delimiter",
      "description": "Text dressed up as a system message or the end of the user's data.",
      "weight": 0.45,
      "weights": {
        "file": 0.15
      },
      "decoded": true,
      "any": [
        "system",
        "instruction",
        "task"
      ],
