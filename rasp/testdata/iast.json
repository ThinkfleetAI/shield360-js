{
  "version": 1,
  "comment": "Passive IAST conformance corpus (sdk/rasp/README.md \"Passive IAST\"). Every case is an ordinary, harmless value: the attack checks must fire nothing on any of them, and the IAST rules must report exactly the expected rule (or nothing when rule is null). Request inputs go through the SDK's input normalizer as in benign.json. Sections: sql, command (command = shell text, argv = a spawn without a shell), path, ssrf, code, include, deser (the hook already decided the loader is unsafe), xml.",
  "fingerprints": [
    { "route": "/api/orders/:id", "sink": "pg.query", "input_key": "query.id", "rule": "vuln.sql_concat", "fingerprint": "da11ad3b5371d315b296e0052f8148ae" }
  ],
  "cases": [
    { "name": "sql: email in a string literal", "check": "sql", "query": "SELECT id, total FROM orders WHERE customer_email = 'alice@example.com'", "inputs": [{ "value": "alice@example.com", "key": "query.email", "source": "request" }], "expect": { "rule": "vuln.sql_concat", "position": "string", "input_key": "query.email" } },
    { "name": "sql: id as a number literal", "check": "sql", "query": "SELECT * FROM orders WHERE id = 48213", "inputs": [{ "value": "48213", "key": "query.id", "source": "request" }], "expect": { "rule": "vuln.sql_concat", "position": "number", "input_key": "query.id" } },
    { "name": "sql: sort column as an identifier", "check": "sql", "query": "SELECT id, total FROM orders ORDER BY created_at", "inputs": [{ "value": "created_at", "key": "query.sort", "source": "request" }], "expect": { "rule": "vuln.sql_concat", "position": "identifier", "input_key": "query.sort" } },
    { "name": "sql: sort with direction across tokens", "check": "sql", "query": "SELECT id FROM orders ORDER BY created_at desc", "inputs": [{ "value": "created_at desc", "key": "query.sort", "source": "request" }], "expect": { "rule": "vuln.sql_concat", "position": "tokens", "input_key": "query.sort" } },
    { "name": "sql: column list", "check": "sql", "query": "SELECT id, total, status FROM orders", "inputs": [{ "value": "id, total, status", "key": "query.fields", "source": "request" }], "expect": { "rule": "vuln.sql_concat", "position": "tokens", "input_key": "query.fields" } },
    { "name": "sql: search term inside LIKE", "check": "sql", "query": "SELECT name FROM products WHERE name LIKE '%blue widget%'", "inputs": [{ "value": "blue widget", "key": "body.search", "source": "request" }], "expect": { "rule": "vuln.sql_concat", "position": "string", "input_key": "body.search" } },
    { "name": "sql: date in a string literal", "check": "sql", "query": "SELECT count(*) FROM events WHERE day >= '2026-10-01'", "inputs": [{ "value": "2026-10-01", "key": "query.from", "source": "request" }], "expect": { "rule": "vuln.sql_concat", "position": "string", "input_key": "query.from" } },
    { "name": "sql: percent-encoded input decoded", "check": "sql", "query": "SELECT * FROM customers WHERE city = 'Saint Paul'", "inputs": [{ "value": "Saint%20Paul", "key": "query.city", "source": "request" }], "expect": { "rule": "vuln.sql_concat", "position": "string", "input_key": "query.city" } },
    { "name": "sql: bound parameter", "check": "sql", "query": "SELECT * FROM orders WHERE id = $1", "dialect": "postgres", "inputs": [{ "value": "48213", "key": "query.id", "source": "request" }], "expect": { "rule": null } },
    { "name": "sql: question-mark parameter", "check": "sql", "query": "SELECT * FROM orders WHERE customer_email = ?", "dialect": "mysql", "inputs": [{ "value": "alice@example.com", "key": "query.email", "source": "request" }], "expect": { "rule": null } },
    { "name": "sql: short number below the threshold", "check": "sql", "query": "SELECT * FROM orders WHERE id = 42", "inputs": [{ "value": "42", "key": "query.id", "source": "request" }], "expect": { "rule": null } },
    { "name": "sql: short common word matches a fixed literal", "check": "sql", "query": "SELECT * FROM users WHERE status = 'active'", "inputs": [{ "value": "active", "key": "query.status", "source": "request" }], "expect": { "rule": null } },
    { "name": "sql: value only in a sqlcommenter comment", "check": "sql", "query": "SELECT 1 /*request_id='req-7f3a9c21'*/", "inputs": [{ "value": "req-7f3a9c21", "key": "header.x-request-id", "source": "request" }], "expect": { "rule": null } },
    { "name": "sql: number inside a longer identifier", "check": "sql", "query": "SELECT order_48213_total FROM report", "inputs": [{ "value": "48213", "key": "query.id", "source": "request" }], "expect": { "rule": null } },
    { "name": "sql: input is the whole query (console)", "check": "sql", "query": "SELECT id FROM orders", "inputs": [{ "value": "SELECT id FROM orders", "key": "body.sql", "source": "request" }], "expect": { "rule": null } },
    { "name": "sql: word inside a longer identifier", "check": "sql", "query": "SELECT id FROM orders GROUP BY procedure_id", "inputs": [{ "value": "procedure", "key": "query.kind", "source": "request" }], "expect": { "rule": null } },
    { "name": "sql: model output is not request input", "check": "sql", "query": "SELECT * FROM orders WHERE customer_email = 'alice@example.com'", "inputs": [{ "value": "alice@example.com", "key": "model.completion", "source": "model_output" }], "expect": { "rule": null } },

    { "name": "command: file name inside a shell word", "check": "command", "command": "convert uploads/photo-48213.png -resize 200x200 thumbs/photo-48213.png", "inputs": [{ "value": "photo-48213", "key": "path.name", "source": "request" }], "expect": { "rule": "vuln.cmd_shell", "position": "word", "input_key": "path.name" } },
    { "name": "command: author as an argv argument", "check": "command", "argv": ["git", "log", "--author", "alice@example.com"], "inputs": [{ "value": "alice@example.com", "key": "query.author", "source": "request" }], "expect": { "rule": "vuln.cmd_arg", "position": "argument", "input_key": "query.author" } },
    { "name": "command: fixed argv", "check": "command", "argv": ["git", "status", "--short"], "inputs": [{ "value": "alice@example.com", "key": "query.author", "source": "request" }], "expect": { "rule": null } },
    { "name": "command: short common word", "check": "command", "command": "ls -la /srv/data", "inputs": [{ "value": "data", "key": "query.dir", "source": "request" }], "expect": { "rule": null } },

    { "name": "path: file name before its extension", "check": "path", "path": "/srv/app/uploads/invoice-2026-0193.pdf", "op": "read", "inputs": [{ "value": "invoice-2026-0193", "key": "query.file", "source": "request" }], "expect": { "rule": "vuln.path_from_input", "position": "segment", "input_key": "query.file" } },
    { "name": "path: directory segment", "check": "path", "path": "/srv/app/reports/q3-summary/index.html", "op": "read", "inputs": [{ "value": "q3-summary", "key": "path.report", "source": "request" }], "expect": { "rule": "vuln.path_from_input", "position": "segment", "input_key": "path.report" } },
    { "name": "path: relative path with a slash", "check": "path", "path": "/srv/app/reports/q3.csv", "op": "read", "inputs": [{ "value": "reports/q3.csv", "key": "query.path", "source": "request" }], "expect": { "rule": "vuln.path_from_input", "position": "segment", "input_key": "query.path" } },
    { "name": "path: number inside a segment", "check": "path", "path": "/srv/app/uploads/user_48213_avatar.png", "op": "read", "inputs": [{ "value": "48213", "key": "query.user", "source": "request" }], "expect": { "rule": null } },
    { "name": "path: input not in the path", "check": "path", "path": "/srv/app/static/logo.png", "op": "read", "inputs": [{ "value": "alice@example.com", "key": "query.email", "source": "request" }], "expect": { "rule": null } },

    { "name": "ssrf: host from a parameter", "check": "ssrf", "url": "https://api.partner-example.com/v1/rates", "resolved": ["93.184.216.34"], "inputs": [{ "value": "api.partner-example.com", "key": "query.host", "source": "request" }], "expect": { "rule": "vuln.ssrf_host", "position": "host", "input_key": "query.host" } },
    { "name": "ssrf: callback URL from the body", "check": "ssrf", "url": "https://hooks.example.org/notify?id=7", "resolved": ["93.184.216.34"], "inputs": [{ "value": "https://hooks.example.org/notify", "key": "body.callback", "source": "request" }], "expect": { "rule": "vuln.ssrf_host", "position": "url", "input_key": "body.callback" } },
    { "name": "ssrf: host only mentioned in a note", "check": "ssrf", "url": "https://api.stripe.com/v1/charges", "resolved": ["93.184.216.34"], "inputs": [{ "value": "Payment failed at api.stripe.com, retry later", "key": "body.note", "source": "request" }], "expect": { "rule": null } },
    { "name": "ssrf: prefix ends in the userinfo, before the fixed host", "check": "ssrf", "url": "https://api.example.org:8443@api.example.org/v1/rates", "resolved": ["93.184.216.34"], "inputs": [{ "value": "https://api.example.org", "key": "query.base", "source": "request" }], "expect": { "rule": null } },
    { "name": "ssrf: input only in the path", "check": "ssrf", "url": "https://api.example.com/v1/users/alice-48213", "resolved": ["93.184.216.34"], "inputs": [{ "value": "alice-48213", "key": "path.user", "source": "request" }], "expect": { "rule": null } },

    { "name": "code: template name in a string literal", "check": "code", "code": "renderTemplate('greeting-card-blue')", "inputs": [{ "value": "greeting-card-blue", "key": "query.template", "source": "request" }], "expect": { "rule": "vuln.code_eval", "position": "string", "input_key": "query.template" } },
    { "name": "code: input not in the code", "check": "code", "code": "Math.max(1, 2)", "inputs": [{ "value": "greeting-card-blue", "key": "query.template", "source": "request" }], "expect": { "rule": null } },

    { "name": "include: locale in a module path", "check": "include", "specifier": "./locales/en-GB.json", "inputs": [{ "value": "en-GB", "key": "header.accept-language", "source": "request" }], "expect": { "rule": "vuln.include_from_input", "position": "specifier", "input_key": "header.accept-language" } },
    { "name": "include: short locale", "check": "include", "specifier": "./locales/en.json", "inputs": [{ "value": "en", "key": "query.lang", "source": "request" }], "expect": { "rule": null } },

    { "name": "deser: request YAML to an unsafe loader", "check": "deser", "format": "yaml", "data": "name: monthly-report\nformat: pdf\n", "inputs": [{ "value": "name: monthly-report\nformat: pdf\n", "key": "body", "source": "request" }], "expect": { "rule": "vuln.deser_input", "position": "data", "input_key": "body" } },
    { "name": "deser: fixed YAML", "check": "deser", "format": "yaml", "data": "retries: 3\n", "inputs": [{ "value": "monthly-report", "key": "query.name", "source": "request" }], "expect": { "rule": null } },

    { "name": "xml: request XML to a resolving parser", "check": "xml", "xml": "<order><id>48213</id><note>leave at door</note></order>", "resolvesExternal": true, "inputs": [{ "value": "<order><id>48213</id><note>leave at door</note></order>", "key": "body", "source": "request" }], "expect": { "rule": "vuln.xml_external", "position": "data", "input_key": "body" } },
    { "name": "xml: request XML to a parser that never resolves", "check": "xml", "xml": "<order><id>48213</id><note>leave at door</note></order>", "resolvesExternal": false, "inputs": [{ "value": "<order><id>48213</id><note>leave at door</note></order>", "key": "body", "source": "request" }], "expect": { "rule": null } }
  ]
}
