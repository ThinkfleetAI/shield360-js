{
  "version": 1,
  "comment": "Event route conformance (sdk/rasp/README.md \"Event route\"). Each case is a request path whose framework gave no route template, and the route every event (attack and vulnerability) must carry: the route fallback, then every segment that is not a short lower-case word (^[a-z][a-z_.-]{0,15}$) or an API version (^v\\d{1,2}$) becomes :id. A token, name or other value in a path must never reach an event.",
  "cases": [
    { "path": "/", "route": "/" },
    { "path": "/health", "route": "/health" },
    { "path": "/api/orders/12345", "route": "/api/orders/:id" },
    { "path": "/api/orders/12345/items/3f2a9c1e-0b1d-4e6f-8a7b-9c0d1e2f3a4b", "route": "/api/orders/:id/items/:id" },
    { "path": "/reset/Zx9TqLm2Rk7WpA4s/confirm", "route": "/reset/:id/confirm" },
    { "path": "/api/v2/reset/AbCdEfGhIjKlMnOp/confirm", "route": "/api/v2/reset/:id/confirm" },
    { "path": "/verify/eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.c2ln", "route": "/verify/:id" },
    { "path": "/invite/abcdefghijklmnopq", "route": "/invite/:id" },
    { "path": "/invite/abcdefghijklmnop", "route": "/invite/abcdefghijklmnop" },
    { "path": "/users/Alice/profile", "route": "/users/:id/profile" },
    { "path": "/users/alice@example.com", "route": "/users/:id" },
    { "path": "/files/report.pdf", "route": "/files/report.pdf" },
    { "path": "/files/q3-report_final.csv", "route": "/files/:id" },
    { "path": "/files/final_v-2.csv", "route": "/files/:id" },
    { "path": "/files/final_v-x.csv", "route": "/files/final_v-x.csv" },
    { "path": "/blobs/deadbeef", "route": "/blobs/deadbeef" },
    { "path": "/blobs/DEADBEEF1", "route": "/blobs/:id" },
    { "path": "/api/v1/rates", "route": "/api/v1/rates" },
    { "path": "/api/v12/rates", "route": "/api/v12/rates" },
    { "path": "/api/v123/rates", "route": "/api/:id/rates" },
    { "path": "/api/V2/rates", "route": "/api/:id/rates" },
    { "path": "/_internal/status", "route": "/:id/status" },
    { "path": "/a/b-c/d.e", "route": "/a/b-c/d.e" },
    { "path": "/reset/abc%20def", "route": "/reset/:id" },
    { "path": "/caf\u00e9/menu", "route": "/:id/menu" },
    { "path": "/search?q=Zx9TqLm2Rk7WpA4s", "route": "/search" },
    { "path": "/api/orders/", "route": "/api/orders/" },
    { "path": "//double", "route": "//double" },
    { "path": "/orders/:id", "route": "/orders/:id" }
  ]
}
